# Copy this file to `.env` for local work. NEVER commit the real `.env`.
# On Vercel, set these in Project Settings > Environment Variables instead.

# --- Database (MongoDB Atlas) ---------------------------------------------
# Connection string of the Atlas cluster (Database > Connect > Drivers).
MONGODB_URI=
MONGODB_DB=agrocultura

# --- Sessions --------------------------------------------------------------
# Long random string (32+ chars). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Initial administrator (created by the seed) ---------------------------
ADMIN_USER=
ADMIN_PASSWORD=

# --- Optional demo narrator (created by the seed only if all three are set) -
SEED_DEMO_NARRATOR_NAME=Ana Beltrán
SEED_DEMO_NARRATOR_PHONE=
SEED_DEMO_NARRATOR_PIN=

# --- Files (Vercel Blob) ---------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Behaviour -------------------------------------------------------------
# "development" (default locally) or "production" (set automatically on Vercel).
APP_ENV=development
# Allows the admin button "Reiniciar datos de ejemplo". Set to false before
# using the platform with real families.
ALLOW_DEMO_RESET=true

# --- Frontend (public values, bundled into the app) ------------------------
# Shows the F-codes (F1, F2, ...) used in the approved design.
VITE_SHOW_CODES=true

# --- Tests only (never point these to the real database) -------------------
# Optional: run the geospatial tests against a real MongoDB. The database name
# must end with "_test". Without it, tests use an in-memory fake database.
# TEST_MONGODB_URI=mongodb://localhost:27017
# TEST_MONGODB_DB=agrocultura_test
