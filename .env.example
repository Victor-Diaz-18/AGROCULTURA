# Copy this file to `.env` for local work. NEVER commit the real `.env`.
# On Vercel, set these in Project Settings > Environment Variables instead.

# --- Database (MongoDB Atlas) ---------------------------------------------
# Connection string of the Atlas cluster (Database > Connect > Drivers).
MONGODB_URI=
MONGODB_DB=agrocultura

# --- Sessions --------------------------------------------------------------
# Long random string (at least 32 chars; sign-in answers 503 without it). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Initial administrator (created by the app on the first request) -------
# ADMIN_PASSWORD: 10+ characters. It is the source of truth: to change the
# administrator password, change this variable and redeploy.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Optional demo narrator (created by the app when PHONE and PIN are set) -
SEED_DEMO_NARRATOR_NAME=Ana Beltrán
SEED_DEMO_NARRATOR_PHONE=
SEED_DEMO_NARRATOR_PIN=

# --- Files (Vercel Blob) ---------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- The voice of the portal (Azure Speech, free F0 plan) -------------------
# Without the key the app reads aloud with the voice of each device. Key and region come from the Speech resource in Azure.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# The voice everybody hears. Colombian voices: es-CO-SalomeNeural (default) and es-CO-GonzaloNeural.
# AZURE_SPEECH_VOICE=es-CO-SalomeNeural
# The most characters a day that may be turned into audio (what was already made costs nothing).
# VOZ_MAX_CARACTERES_DIA=15000

# --- Behaviour -------------------------------------------------------------
# "development" (default locally) or "production" (set automatically on Vercel).
APP_ENV=development
# Allows the admin button "Reiniciar datos de ejemplo". Set to false before
# using the platform with real families.
ALLOW_DEMO_RESET=true

# --- Frontend (public values, bundled into the app) ------------------------
# The F-codes (F1, F2, ...) of the approved design are notes for the team, not for the families: they are hidden by
# default. Set this to true (in .env, or in Vercel for a preview) to see them while comparing screens with the design.
# It is read when the app is BUILT, so changing it on Vercel needs a new deploy.
# VITE_SHOW_CODES=true

# --- Tests only (never point these to the real database) -------------------
# Optional: run the geospatial tests against a real MongoDB. The database name
# must end with "_test". Without it, tests use an in-memory fake database.
# TEST_MONGODB_URI=mongodb://localhost:27017
# TEST_MONGODB_DB=agrocultura_test
